<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rebuilt project file: the upstream repo ships only the .cs files and a prebuilt DLL.
       Game, BepInEx and Jotunn assemblies are compile-time references only (never copied
       or committed); point ValheimRefs at a folder holding them. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ValheimRandomizer</AssemblyName>
    <RootNamespace>ValheimRandomizer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ValheimRefs Condition="'$(ValheimRefs)' == ''">$(MSBuildThisFileDirectory)../../valheim-archipelago-refs</ValheimRefs>
  </PropertyGroup>

  <!-- dotnet build -p:FastTest=true: playtest build with a 1 Wood + 1 Stone Research Bench. -->
  <PropertyGroup Condition="'$(FastTest)' == 'true'">
    <DefineConstants>$(DefineConstants);FASTTEST</DefineConstants>
  </PropertyGroup>

  <!-- Extra check definitions, shared with the APWorld (tools/gen_apworld_data.py). -->
  <ItemGroup>
    <EmbeddedResource Include="../mod/checks.tsv" LogicalName="checks.tsv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ValheimRefs)/game/assembly_*.dll" Private="false" />
    <Reference Include="$(ValheimRefs)/game/UnityEngine*.dll" Private="false" />
    <Reference Include="$(ValheimRefs)/game/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ValheimRefs)/bepinex/BepInExPack_Valheim/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(ValheimRefs)/bepinex/BepInExPack_Valheim/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(ValheimRefs)/jotunn/Jotunn.dll" Private="false" />
  </ItemGroup>

</Project>
